{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norte",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-30",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
